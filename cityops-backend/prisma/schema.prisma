generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  citizen
  office
  admin
}

enum ComplaintStatus {
  Submitted
  Assigned
  InProgress
  PendingVerification
  Resolved
}

model User {
  id            String   @id @default(uuid())
  userId        String   @unique
  passwordHash  String
  name          String?
  mobile        String?
  role          Role     @default(citizen)
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  createdAt     DateTime @default(now())

  complaints    Complaint[]
}

model Department {
  id         String     @id @default(uuid())
  name       String     @unique
  users      User[]
  categories Category[]
  complaints Complaint[]
}

model Category {
  id             String     @id @default(uuid())
  name           String     @unique
  severityWeight Int        @default(1)
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id])
  complaints     Complaint[]
}

model Ward {
  id         String      @id @default(uuid())
  name       String
  zone       String?
  complaints Complaint[]
}

model Complaint {
  id             String    @id @default(uuid())
  trackingId     String    @unique
  citizenId      String?
  citizen        User?     @relation(fields: [citizenId], references: [id])
  name           String?
  mobile         String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  photoUrl       String
  lat            Float
  lng            Float
  addressLine    String?
  landmark       String?
  wardId         String?
  ward           Ward?     @relation(fields: [wardId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  priorityScore  Int?
  status         ComplaintStatus @default(Submitted)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  statusUpdates  StatusUpdate[]
}

model StatusUpdate {
  id                String   @id @default(uuid())
  complaintId       String
  complaint         Complaint @relation(fields: [complaintId], references: [id])
  updatedBy         String?
  oldStatus         String
  newStatus         String
  note              String?
  evidencePhotoUrl  String?
  timestamp         DateTime @default(now())
}

model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}